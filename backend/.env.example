NODE_ENV=production
PORT=3001
FASTIFY_PORT=3002

# PostgreSQL — banco compartilhado multi-tenant
DATABASE_URL="postgresql://usuario:senha@localhost:5432/restaurante_pdv?schema=public"

# JWT — OBRIGATÓRIO: gere segredos criptograficamente seguros antes de ir para produção
# Comando para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cada segredo deve ter pelo menos 32 caracteres e ser único
JWT_SECRET=<gere_com_crypto_randomBytes_48>
JWT_ACCESS_SECRET=<gere_com_crypto_randomBytes_48>
JWT_REFRESH_SECRET=<gere_com_crypto_randomBytes_48>
JWT_EXPIRES_IN=8h

# License
LICENSE_SECRET=<gere_com_crypto_randomBytes_32>

# CORS — origens permitidas separadas por vírgula (sem espaço no final)
# Exemplo com múltiplas: http://192.168.1.10:3000,http://192.168.1.11:3000
CORS_ORIGIN=http://localhost:3000

# Log
LOG_LEVEL=info
