NODE_ENV=production
PORT=3001
FASTIFY_PORT=3002

# PostgreSQL — banco compartilhado multi-tenant
DATABASE_URL="postgresql://usuario:senha@localhost:5432/restaurante_pdv?schema=public"

# JWT — use segredos longos e únicos em produção
JWT_SECRET=troque_este_segredo_em_producao
JWT_ACCESS_SECRET=troque_acesso_em_producao
JWT_REFRESH_SECRET=troque_refresh_em_producao
JWT_EXPIRES_IN=8h

# License
LICENSE_SECRET=troque_licenca_em_producao

# CORS — origem do frontend
CORS_ORIGIN=http://localhost:3000

# Log
LOG_LEVEL=info
