generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ativo
  suspenso
  cancelado
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum UserCargo {
  administrador
  garcom
  caixa
  cozinha
}

enum MesaStatus {
  aberta // recebendo lançamentos
  fechando // conta impressa, aguardando pagamento — bloqueia novos itens
  fechada // quitada ou encerrada com justificativa
}

enum PedidoStatus {
  aberto
  preparando
  pronto
  entregue
  fechado
  cancelado
}

enum PedidoItemStatus {
  pendente
  preparando
  pronto
  entregue
  cancelado
}

enum CaixaStatus {
  aberto
  fechado
}

enum MovimentoCaixaTipo {
  suprimento
  sangria
  pagamento
  estorno
}

enum PagamentoStatus {
  pendente
  confirmado
  estornado
}

enum LicencaStatus {
  ativado
  pendente
  bloqueado
}

enum DispositivoStatus {
  ativo
  suspenso
  bloqueado
  inativo
}

enum EstoqueMovimentoTipo {
  entrada
  saida
}

// ── Tenant ─────────────────────────────────────────────────────────────────────

model Tenant {
  id                    String                 @id @default(uuid())
  /// Código numérico do cliente (1001, 1002...): usado no login e no controle
  codigo                Int                    @unique @default(autoincrement())
  nome                  String
  slug                  String                 @unique
  cnpj                  String?                @unique
  cpfResponsavel        String?                @map("cpf_responsavel")
  contato               String?
  responsavel           String?
  telefone              String?
  endereco              String?
  cidade                String?
  uf                    String?
  observacoes           String?
  vendaMobilePermitida  Boolean                @default(true) @map("venda_mobile_permitida")
  rfidDisponivel        Boolean                @default(false) @map("rfid_disponivel")
  /// restaurante, bar, lanchonete… (lib/tipoComercio.ts). Classifica e define o ponto de partida na criação.
  tipoComercio          String?                @map("tipo_comercio")
  /// Exceção do superadmin aos recursos do plano: null segue o plano
  rfidManual            Boolean?               @map("rfid_manual")
  vendaMobileManual     Boolean?               @map("venda_mobile_manual")
  /// Pacote contratado. Com plano, os recursos acima seguem o plano.
  planoId               String?                @map("plano_id")
  plano                 Plano?                 @relation(fields: [planoId], references: [id], onDelete: SetNull)
  /// Obsoletos: a cobrança mora no Contrato desde a migração da assinatura.
  /// Ficam até o próximo deploy para a API antiga não quebrar durante a troca.
  cobrancaDiaVencimento Int                    @default(10) @map("cobranca_dia_vencimento")
  cobrancaValor         Decimal?               @map("cobranca_valor") @db.Decimal(10, 2)
  cobrancaIsento        Boolean                @default(false) @map("cobranca_isento")
  cobrancaObs           String?                @map("cobranca_obs")
  pagamentosMensalidade PagamentoMensalidade[]
  status                TenantStatus           @default(ativo)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  usuarios             Usuario[]
  perfis               Perfil[]
  categorias           Categoria[]
  produtos             Produto[]
  metodosPagamento     MetodoPagamento[]
  mesas                Mesa[]
  pedidos              Pedido[]
  caixas               Caixa[]
  movimentosCaixa      MovimentoCaixa[]
  pagamentos           Pagamento[]
  auditoria            Auditoria[]
  configuracoes        Configuracoes?
  impressoras          Impressora[]
  pedidosOnline        PedidoOnline[]
  movimentacoesEstoque MovimentacaoEstoque[]
  dispositivos         Dispositivo[]
  licencas             Licenca[]
  contratos            Contrato[]
  contratoVersoes      ContratoVersao[]
  tickets              TicketSuporte[]

  // relações adicionadas pelas correções do PDV
  abatimentos Abatimento[]
  pedidoItens PedidoItem[]

  @@map("tenants")
}

// ── Platform User ──────────────────────────────────────────────────────────────

model PlatformUser {
  id          String       @id @default(uuid())
  nome        String
  email       String       @unique
  senhaHash   String       @map("senha_hash")
  role        PlatformRole @default(SUPPORT)
  ativo       Boolean      @default(true)
  ultimoLogin DateTime?    @map("ultimo_login")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  refreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id             String    @id @default(uuid())
  platformUserId String    @map("platform_user_id")
  tokenHash      String    @unique @map("token_hash")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("platform_refresh_tokens")
}

// ── Usuário do Tenant ──────────────────────────────────────────────────────────

model Usuario {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  /// Sequencial dentro do restaurante (1, 2, 3...), preenchido por trigger no banco
  codigo      Int       @default(dbgenerated())
  /// Nome de usuário para login (minúsculo, começa com letra), único na plataforma
  login       String?   @unique
  nome        String
  email       String?
  senhaHash   String?   @map("senha_hash")
  cartaoRfid  String?   @map("cartao_rfid")
  cargo       UserCargo
  pin         String?
  perfilId    String?   @map("perfil_id")
  ativo       Boolean   @default(true)
  ultimoLogin DateTime? @map("ultimo_login")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  perfil               Perfil?               @relation(fields: [perfilId], references: [id])
  refreshTokens        RefreshToken[]
  mesasGarcom          Mesa[]                @relation("GarcomMesas")
  pedidos              Pedido[]
  caixasAbertos        Caixa[]               @relation("FuncionarioCaixa")
  caixasFechados       Caixa[]               @relation("FechadoPor")
  movimentosCaixa      MovimentoCaixa[]
  pagamentos           Pagamento[]
  auditoria            Auditoria[]
  movimentacoesEstoque MovimentacaoEstoque[]

  // relações adicionadas pelas correções do PDV
  mesasEncerradas       Mesa[]       @relation("EncerradaPor")
  abatimentosFeitos     Abatimento[] @relation("AbatimentoAutor")
  abatimentosCancelados Abatimento[] @relation("AbatimentoCancelador")
  itensLancados         PedidoItem[] @relation("ItemLancadoPor")
  pagamentosEstornados  Pagamento[]  @relation("PagamentoEstornadoPor")

  @@unique([tenantId, codigo])
  @@unique([tenantId, email])
  @@unique([tenantId, cartaoRfid])
  @@index([tenantId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ── Perfis de Permissão ────────────────────────────────────────────────────────

model Perfil {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  nome       String
  descricao  String?
  permissoes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  usuarios Usuario[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("perfis")
}

// ── Categorias ─────────────────────────────────────────────────────────────────

model Categoria {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  nome       String
  vaiCozinha Boolean  @default(true) @map("vai_cozinha")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  produtos Produto[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("categorias")
}

// ── Produtos ───────────────────────────────────────────────────────────────────

model Produto {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  nome                String
  descricao           String?
  preco               Decimal  @db.Decimal(10, 2)
  categoriaId         String?  @map("categoria_id")
  imagemUrl           String?  @map("imagem_url")
  tempoPreparoMinutos Int      @default(0) @map("tempo_preparo_minutos")
  ativo               Boolean  @default(true)
  estoqueAtual        Decimal  @default(0) @map("estoque_atual") @db.Decimal(10, 3)
  estoqueMinimo       Decimal  @default(0) @map("estoque_minimo") @db.Decimal(10, 3)
  gerenciarEstoque    Boolean  @default(false) @map("gerenciar_estoque")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  categoria            Categoria?            @relation(fields: [categoriaId], references: [id])
  pedidoItens          PedidoItem[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@index([tenantId])
  @@index([tenantId, ativo])
  @@map("produtos")
}

// ── Métodos de Pagamento ───────────────────────────────────────────────────────

model MetodoPagamento {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  nome     String
  ativo    Boolean @default(true)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  pagamentos Pagamento[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("metodos_pagamento")
}

// ── Mesas ──────────────────────────────────────────────────────────────────────

model Mesa {
  id             String     @id @default(uuid())
  tenantId       String     @map("tenant_id")
  numero         Int
  cliente        String?
  nomeMesa       String?    @map("nome_mesa")
  status         MesaStatus @default(aberta)
  garcomId       String?    @map("garcom_id")
  caixaId        String?    @map("caixa_id")
  dataAbertura   DateTime?  @map("data_abertura")
  dataFechamento DateTime?  @map("data_fechamento")
  observacoes    String?

  // Encerramento sem quitação exige justificativa e responsável.
  // Antes `fechar()` não checava saldo nenhum: a dívida sumia da operação
  // e o pedido ficava `aberto` para sempre.
  encerradaSemPagamento Boolean @default(false) @map("encerrada_sem_pagamento")
  motivoEncerramento    String? @map("motivo_encerramento")
  encerradaPorId        String? @map("encerrada_por")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  garcom       Usuario?    @relation("GarcomMesas", fields: [garcomId], references: [id])
  encerradaPor Usuario?    @relation("EncerradaPor", fields: [encerradaPorId], references: [id])
  caixa        Caixa?      @relation(fields: [caixaId], references: [id])
  pedidos      Pedido[]
  pagamentos   Pagamento[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, dataAbertura])
  @@map("mesas")
}

// ── Pedidos ────────────────────────────────────────────────────────────────────

model Pedido {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  mesaId      String?      @map("mesa_id")
  garcomId    String       @map("garcom_id")
  status      PedidoStatus @default(aberto)
  taxaPct     Decimal      @default(0) @map("taxa_pct") @db.Decimal(5, 2)
  /// Taxa de entrega (delivery). Entra no total, fora do desconto e da taxa de serviço.
  taxaEntrega Decimal      @default(0) @map("taxa_entrega") @db.Decimal(10, 2)

  /// Nº sequencial por tenant, para a ficha impressa. Antes a venda direta
  /// gerava `F${Date.now()}` que não era persistido em lugar nenhum — não
  /// havia como localizar depois a venda pelo número dado ao cliente.
  numero Int

  observacoes String?
  fechadoEm   DateTime? @map("fechado_em")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  mesa        Mesa?         @relation(fields: [mesaId], references: [id])
  garcom      Usuario       @relation(fields: [garcomId], references: [id])
  itens       PedidoItem[]
  pagamentos  Pagamento[]
  abatimentos Abatimento[]
  online      PedidoOnline?

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, mesaId])
  @@map("pedidos")
}

model PedidoItem {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  pedidoId  String @map("pedido_id")
  produtoId String @map("produto_id")

  /// Nº da rodada dentro do pedido. Itens da mesma rodada saem na mesma ficha.
  rodada Int @default(1)

  quantidade    Int
  precoUnitario Decimal          @map("preco_unitario") @db.Decimal(10, 2)
  precoTotal    Decimal          @map("preco_total") @db.Decimal(10, 2)
  status        PedidoItemStatus @default(pendente)
  observacao    String?

  /// Quem lançou. Antes só o pedido tinha garçom; numa troca de turno não
  /// dava para saber quem lançou o quê.
  lancadoPorId String? @map("lancado_por")

  canceladoPorId     String? @map("cancelado_por")
  motivoCancelamento String? @map("motivo_cancelamento")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto  @relation(fields: [produtoId], references: [id])
  lancadoPor Usuario? @relation("ItemLancadoPor", fields: [lancadoPorId], references: [id])

  @@index([tenantId])
  @@index([pedidoId, rodada])
  @@index([tenantId, status])
  @@map("pedido_itens")
}

// ── Caixa ──────────────────────────────────────────────────────────────────────

model Caixa {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  funcionarioId        String      @map("funcionario_id")
  valorInicial         Decimal     @map("valor_inicial") @db.Decimal(10, 2)
  valorFechamento      Decimal?    @map("valor_fechamento") @db.Decimal(10, 2)
  dataAbertura         DateTime    @default(now()) @map("data_abertura")
  fechadoEm            DateTime?   @map("fechado_em")
  status               CaixaStatus @default(aberto)
  valorContado         Decimal?    @map("valor_contado") @db.Decimal(10, 2)
  diferenca            Decimal?    @db.Decimal(10, 2)
  observacaoFechamento String?     @map("observacao_fechamento")
  fechadoPorId         String?     @map("fechado_por")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  funcionario Usuario          @relation("FuncionarioCaixa", fields: [funcionarioId], references: [id])
  fechadoPor  Usuario?         @relation("FechadoPor", fields: [fechadoPorId], references: [id])
  movimentos  MovimentoCaixa[]
  mesas       Mesa[]
  pagamentos  Pagamento[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("caixa")
}

model MovimentoCaixa {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  caixaId     String             @map("caixa_id")
  tipo        MovimentoCaixaTipo
  valor       Decimal            @db.Decimal(10, 2)
  descricao   String?
  usuarioId   String             @map("usuario_id")
  /// Pagamento de origem (tipo pagamento/estorno). Permite estornar pelo caixa.
  pagamentoId String?            @map("pagamento_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  caixa   Caixa   @relation(fields: [caixaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@index([caixaId])
  @@index([pagamentoId])
  @@map("movimentos_caixa")
}

// ── Pagamentos ─────────────────────────────────────────────────────────────────

model Pagamento {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  mesaId        String?         @map("mesa_id")
  pedidoId      String          @map("pedido_id")
  metodoId      String          @map("metodo_id")
  valor         Decimal         @db.Decimal(10, 2)
  /// Valor físico entregue pelo cliente. Antes só existia `troco`, e não dava
  /// para reconstruir a conferência da gaveta.
  valorRecebido Decimal         @map("valor_recebido") @db.Decimal(10, 2)
  troco         Decimal         @default(0) @db.Decimal(10, 2)
  caixaId       String          @map("caixa_id")
  usuarioId     String          @map("usuario_id")
  status        PagamentoStatus @default(confirmado)

  /// Enviada pelo cliente. Unique por tenant — o retry devolve o mesmo
  /// pagamento em vez de criar outro.
  idempotencyKey String @map("idempotency_key")

  estornadoEm    DateTime? @map("estornado_em")
  estornadoPorId String?   @map("estornado_por")
  motivoEstorno  String?   @map("motivo_estorno")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  mesa         Mesa?           @relation(fields: [mesaId], references: [id])
  pedido       Pedido          @relation(fields: [pedidoId], references: [id])
  metodo       MetodoPagamento @relation(fields: [metodoId], references: [id])
  caixa        Caixa           @relation(fields: [caixaId], references: [id])
  usuario      Usuario         @relation(fields: [usuarioId], references: [id])
  estornadoPor Usuario?        @relation("PagamentoEstornadoPor", fields: [estornadoPorId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, caixaId])
  @@index([pedidoId])
  @@map("pagamentos")
}

// ── Auditoria ──────────────────────────────────────────────────────────────────

model Auditoria {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  usuarioId  String?  @map("usuario_id")
  acao       String
  entidade   String?
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("auditoria")
}

// ── Configurações ──────────────────────────────────────────────────────────────

model Configuracoes {
  id                     String  @id @default(uuid())
  tenantId               String  @unique @map("tenant_id")
  nomeRestaurante        String  @default("Restaurante") @map("nome_restaurante")
  logoBase64             String? @map("logo_base64")
  logoTamanho            String? @map("logo_tamanho")
  logoAlturaCustom       Int?    @map("logo_altura_custom")
  mensagemFicha          String? @map("mensagem_ficha")
  impressoraLargura      Int     @default(80) @map("impressora_largura")
  impressoraCopias       Int     @default(1) @map("impressora_copias")
  impressoraAutoImprimir Boolean @default(false) @map("impressora_auto_imprimir")
  impressoraTipo         String  @default("usb") @map("impressora_tipo")
  impressoraHost         String? @map("impressora_host")
  impressoraPorta        Int?    @map("impressora_porta")
  taxaServicoPct         Decimal @default(0) @map("taxa_servico_pct") @db.Decimal(5, 2)
  modoVenda              String  @default("mesa") @map("modo_venda")
  rfidAtivo              Boolean @default(false) @map("rfid_ativo")
  /// Venda pelo celular (QR por funcionário). Só vale se o plano liberar; o admin pode desligar.
  vendaMobileAtiva       Boolean @default(true) @map("venda_mobile_ativa")
  /// Cardápio online / delivery (o plano libera em Plano.delivery)
  deliveryAtivo          Boolean @default(false) @map("delivery_ativo")
  deliveryTaxa           Decimal @default(0) @map("delivery_taxa") @db.Decimal(10, 2)
  deliveryPedidoMinimo   Decimal @default(0) @map("delivery_pedido_minimo") @db.Decimal(10, 2)
  deliveryTempoMin       Int     @default(40) @map("delivery_tempo_min")
  deliveryRetirada       Boolean @default(true) @map("delivery_retirada")
  deliveryEntrega        Boolean @default(true) @map("delivery_entrega")
  deliveryMensagem       String? @map("delivery_mensagem")
  mpAtivado              Boolean @default(false) @map("mp_ativado")
  mpAccessToken          String? @map("mp_access_token")
  mpDeviceId             String? @map("mp_device_id")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("configuracoes")
}

// ── Impressoras ────────────────────────────────────────────────────────────────

model Impressora {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  nome      String
  destino   String // caixa | cozinha | bar
  tipo      String // navegador | rede | windows
  host      String?
  porta     Int      @default(9100)
  largura   Int      @default(80)
  copias    Int      @default(1)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("impressoras")
}

// ── Estoque ────────────────────────────────────────────────────────────────────

model MovimentacaoEstoque {
  id         String               @id @default(uuid())
  tenantId   String               @map("tenant_id")
  produtoId  String               @map("produto_id")
  tipo       EstoqueMovimentoTipo
  quantidade Decimal              @db.Decimal(10, 3)
  motivo     String?
  usuarioId  String?              @map("usuario_id")
  createdAt  DateTime             @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  produto Produto  @relation(fields: [produtoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@index([tenantId, produtoId])
  @@map("movimentacoes_estoque")
}

// ── Dispositivo / Instalação ───────────────────────────────────────────────────

model Dispositivo {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  licencaId            String?           @map("licenca_id")
  instalacaoUuid       String?           @unique @map("instalacao_uuid")
  nome                 String?
  versao               String?
  hostFingerprint      String?           @map("host_fingerprint")
  status               DispositivoStatus @default(ativo)
  syncToken            String?           @unique @map("sync_token")
  syncBloqueado        Boolean           @default(false) @map("sync_bloqueado")
  syncSuspenso         Boolean           @default(false) @map("sync_suspenso")
  vendaMobilePermitida Boolean           @default(false) @map("venda_mobile_permitida")
  ultimoSyncEm         DateTime?         @map("ultimo_sync_em")
  ultimoSyncErro       String?           @map("ultimo_sync_erro")
  centralUrl           String?           @map("central_url")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  licenca Licenca? @relation(fields: [licencaId], references: [id])

  @@index([tenantId])
  @@map("dispositivos")
}

// ── Licença ────────────────────────────────────────────────────────────────────

model Licenca {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  chaveAtivacao     String?       @map("chave_ativacao")
  status            LicencaStatus @default(pendente)
  dataAtivacao      DateTime?     @map("data_ativacao")
  dataVencimento    DateTime?     @map("data_vencimento")
  ultimaVerificacao DateTime?     @map("ultima_verificacao")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  dispositivos Dispositivo[]

  @@index([tenantId])
  @@map("licencas")
}

// ── Contratos (CRM de plataforma) ─────────────────────────────────────────────

enum ContratoCiclo {
  mensal
  trimestral
  semestral
  anual
}

enum ContratoStatus {
  trial
  ativo
  suspenso
  cancelado
}

model Contrato {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  plano             String
  valor             Decimal?       @db.Decimal(10, 2)
  ciclo             ContratoCiclo  @default(mensal)
  dataInicio        DateTime?      @map("data_inicio") @db.Date
  dataFim           DateTime?      @map("data_fim") @db.Date
  status            ContratoStatus @default(ativo)
  observacoes       String?
  /// Assinatura: o pagamento empurra o próximo vencimento um ciclo; a licença é derivada daqui
  diaVencimento     Int            @default(10) @map("dia_vencimento")
  proximoVencimento DateTime?      @map("proximo_vencimento") @db.Date
  /// Teste grátis: liberado até o fim deste dia, sem tolerância
  testeAte          DateTime?      @map("teste_ate") @db.Date
  isento            Boolean        @default(false)
  ajusteMotivo      String?        @map("ajuste_motivo")
  ajusteEm          DateTime?      @map("ajuste_em")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contratos")
}

/// Cada mudança no texto do contrato gera uma versão nova; as antigas ficam
/// guardadas para o PDF de qualquer versão sair igual ao que foi enviado.
model ContratoVersao {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  numero    Int
  /// Tudo o que o PDF precisa: contratada, contratante e condições
  dados     Json
  /// sha256 de `dados`, para saber se uma edição mudou o contrato
  hash      String
  motivo    String?
  enviadoEm DateTime? @map("enviado_em")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numero])
  @@map("contrato_versoes")
}

// ── Planos (pacotes de recursos vendidos pela plataforma) ──────────────────────

model Plano {
  id          String   @id @default(uuid())
  nome        String   @unique
  descricao   String?
  /// Valor mensal de referência (o contrato pode ter outro valor negociado)
  valor       Decimal  @default(0) @db.Decimal(10, 2)
  rfid        Boolean  @default(false)
  vendaMobile Boolean  @default(false) @map("venda_mobile")
  /// Ainda sem recurso no sistema; registrado para os pacotes
  delivery    Boolean  @default(false)
  nfce        Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("planos")
}

// ── Mensalidades (pagamentos dos restaurantes à plataforma) ───────────────────

model PagamentoMensalidade {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  /// Mês de referência no formato AAAA-MM
  competencia   String
  valor         Decimal   @db.Decimal(10, 2)
  pagoEm        DateTime  @map("pago_em") @db.Date
  forma         String?
  observacao    String?
  /// Período coberto pelo pagamento: [início, fim), fim = próximo vencimento
  periodoInicio DateTime? @map("periodo_inicio") @db.Date
  periodoFim    DateTime? @map("periodo_fim") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, competencia])
  @@index([competencia])
  @@map("pagamentos_mensalidade")
}

// ── Tickets de Suporte (CRM de plataforma) ───────────────────────────────────

enum TicketTipo {
  sync
  instalacao
  bug
  cobranca
  outro
}

enum TicketPrioridade {
  baixa
  media
  alta
  urgente
}

enum TicketStatus {
  aberto
  em_andamento
  resolvido
  fechado
}

model TicketSuporte {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  tipo       TicketTipo       @default(outro)
  prioridade TicketPrioridade @default(media)
  status     TicketStatus     @default(aberto)
  titulo     String
  descricao  String?
  resolucao  String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tickets_suporte")
}

enum AbatimentoTipo {
  valor // R$ fixo
  percentual // % sobre o líquido no momento da aplicação
  cortesia // item ou conta por conta da casa
}

model Abatimento {
  id       String         @id @default(uuid())
  tenantId String         @map("tenant_id")
  pedidoId String         @map("pedido_id")
  tipo     AbatimentoTipo @default(valor)

  /// Valor em reais efetivamente abatido, já resolvido (percentual vira R$).
  valor      Decimal  @db.Decimal(10, 2)
  /// Guardado só para exibição quando tipo = percentual.
  percentual Decimal? @db.Decimal(5, 2)

  motivo    String
  usuarioId String @map("usuario_id")

  cancelado      Boolean   @default(false)
  canceladoEm    DateTime? @map("cancelado_em")
  canceladoPorId String?   @map("cancelado_por")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  pedido       Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation("AbatimentoAutor", fields: [usuarioId], references: [id])
  canceladoPor Usuario? @relation("AbatimentoCancelador", fields: [canceladoPorId], references: [id])

  @@index([tenantId])
  @@index([pedidoId])
  @@map("abatimentos")
}

model Sequencia {
  tenantId String @map("tenant_id")
  nome     String // 'pedido' | 'mesa'
  valor    Int    @default(0)

  @@id([tenantId, nome])
  @@map("sequencias")
}

// ── Delivery: pedido feito pelo cliente no cardápio online ─────────────────────

enum PedidoOnlineStatus {
  recebido // chegou; o caixa aceita ou recusa
  aceito // virou Pedido; itens na cozinha
  pronto // cozinha terminou
  em_rota // saiu para entrega
  entregue // entregue/retirado e pago
  recusado
  cancelado
}

enum PedidoOnlineTipo {
  entrega
  retirada
}

model PedidoOnline {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  /// Código curto que o cliente usa para acompanhar (único na plataforma)
  codigo          String             @unique
  status          PedidoOnlineStatus @default(recebido)
  tipo            PedidoOnlineTipo   @default(entrega)
  clienteNome     String             @map("cliente_nome")
  clienteTelefone String             @map("cliente_telefone")
  endereco        String?
  numero          String?
  bairro          String?
  complemento     String?
  referencia      String?
  /// Itens como o cliente pediu (nome e preço do momento): [{produtoId, nome, quantidade, preco, observacao}]
  itens           Json
  subtotal        Decimal            @db.Decimal(10, 2)
  taxaEntrega     Decimal            @default(0) @map("taxa_entrega") @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  /// dinheiro | cartao | pix — pago na entrega/retirada
  formaPagamento  String             @map("forma_pagamento")
  trocoPara       Decimal?           @map("troco_para") @db.Decimal(10, 2)
  observacao      String?
  motivoRecusa    String?            @map("motivo_recusa")
  pedidoId        String?            @unique @map("pedido_id")
  aceitoPorId     String?            @map("aceito_por")
  aceitoEm        DateTime?          @map("aceito_em")
  prontoEm        DateTime?          @map("pronto_em")
  saiuEm          DateTime?          @map("saiu_em")
  entregueEm      DateTime?          @map("entregue_em")
  canceladoEm     DateTime?          @map("cancelado_em")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("pedidos_online")
}
